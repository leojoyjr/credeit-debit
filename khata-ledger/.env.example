# Khata Ledger Configuration
PORT=3000
NODE_ENV=development

# Database path (relative to project root or absolute)
DB_PATH=./data/khata.db

# Security: Session secret (change this in production)
SESSION_SECRET=khata_super_secret_session_key_replace_in_production_32chars!

# Business profile defaults
BUSINESS_NAME=Khata Ledger
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
DEFAULT_TAX_RATE=18
